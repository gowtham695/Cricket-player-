ransform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 601.73px; height: 173.93px;"><img alt="" src="https://docs.google.com/u/0/docs-images-rt/ALKuztYOMnyBAiVShH9R9RVOR-LuO4DKwyLjh6ft8hU5W_KMnn4H_ZpLdXf0vb_wIDPpVtAFzrA4sJ_Ww_873oy57ShckHhfsFgY9CfYDcFXzbjHD0DNrxyGqK2b6LxwANWrvJOqqzkYHM8h3Go0xYnPPv5fmV7D5cc=s320" style="width: 601.73px; height: 173.93px; margin-left: -0.00px; margin-top: -0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p style="padding-top:14pt;margin:0;color:#000000;padding-left:0;font-size:12pt;padding-bottom:14pt;line-height:1.0;font-family:&quot;Calibri&quot;;orphans:2;widows:2;height:12pt;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:13.5pt;font-family:&quot;Cambria&quot;;font-style:normal"></span></p><ol class="lst-kix_list_11-1" start="4" style="padding:0;margin:0"><li style="padding-top:14pt;color:#000000;padding-left:0pt;font-size:12pt;padding-bottom:0pt;line-height:1.0;margin-right:0;margin-left:61.1pt;font-family:&quot;Calibri&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Cambria&quot;;font-style:normal">Generating quizzes: </span></li></ol><p style="padding:0;color:#000000;font-size:12pt;line-height:1.0;margin-right:0;margin-left:61.1pt;font-family:&quot;Calibri&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;height:12pt;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Cambria&quot;;font-style:normal"></span></p><p style="padding-top:0pt;color:#000000;padding-left:0;font-size:12pt;padding-bottom:14pt;line-height:1.0;margin-right:0;margin-left:36pt;font-family:&quot;Calibri&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Cambria&quot;;font-style:normal">It generates three questions with 4 options each. It corrects the answer if chosen wrong</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:13.5pt;font-family:&quot;Cambria&quot;;font-style:normal">. </span></p><p style="padding-top:14pt;margin:0;color:#000000;padding-left:0;font-size:12pt;padding-bottom:14pt;font-family:&quot;Calibri&quot;;line-height:1.0;orphans:2;widows:2;text-align:left;padding-right:0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 601.73px; height: 210.60px;"><img alt="" src="https://docs.google.com/u/0/docs-images-rt/ALKuztbnkwpri6GICKQPwBTA-h7BVmYFpEFRAzENiqJscnnE-4hVsmAoSkn1M3rYgUhy3eBZ_JqfhIeX5Wb1DlQi5kGM-tppQr0ZYBNcDX6kbmUlC8XmdqzRPKEXk7LzbrK_ZxdB8_pZqfkM2irpoR6ElFrAwsupp51wSQ=s320" style="width: 601.73px; height: 210.60px; margin-left: -0.00px; margin-top: -0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p style="padding-top:14pt;margin:0;color:#000000;padding-left:0;font-size:12pt;padding-bottom:14pt;font-family:&quot;Calibri&quot;;line-height:1.0;orphans:2;widows:2;text-align:left;padding-right:0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 601.73px; height: 210.60px;"><img alt="" src="https://docs.google.com/u/0/docs-images-rt/ALKuztZXe_EG-K5jDpoKKNi2Ifm12u3tmQb6HsCEsYdkhRHLkZQgpWSL94dWtx-BG-pBMHN5t_YluNkh13920zNcMk4G_OalowEK6ekOBgcqw57-70x70H6ENfwTl4DLY